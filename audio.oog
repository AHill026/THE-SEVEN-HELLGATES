// THE SEVEN HELLGATES — AUDIO SYSTEM
// ==========================================

// HOME SCREEN MUSIC
const menuMusic = new Audio('./audio/hellgates-main-theme.ogg');

menuMusic.loop = true;
menuMusic.volume = 0.35;

import {

  playMenuMusic,

  fadeMenuMusic,

  startLimboMusic,

  stopLimboMusic

} from './audio.js';

// FADE HOME MUSIC AND ENTER LIMBO
export function fadeMenuMusic(duration = 1500) {
  const startVolume = menuMusic.volume;
  const steps = 30;
  const stepTime = duration / steps;
  let step = 0;

  const fade = setInterval(() => {
    step++;

    menuMusic.volume = Math.max(
      0,
      startVolume * (1 - step / steps)
    );

    if (step >= steps) {
      clearInterval(fade);
      menuMusic.pause();
      menuMusic.currentTime = 0;
      menuMusic.volume = startVolume;

      startLimboMusic();
    }
  }, stepTime);
}

// LIMBO ORIGINAL AMBIENT SOUNDTRACK
let limboContext = null;
let limboMaster = null;
let limboOscillators = [];
let drumTimer = null;
let drumIntensity = 0;

// STOP LIMBO MUSIC

export function playInfernalDrum(intensity = 1) {
  if (!limboContext || !limboMaster) return;

  const now = limboContext.currentTime;

  // Deep cinematic drum
  const drum = limboContext.createOscillator();
  const drumGain = limboContext.createGain();

  drum.type = 'sine';

  drum.frequency.setValueAtTime(85, now);
  drum.frequency.exponentialRampToValueAtTime(28, now + 0.45);

  drumGain.gain.setValueAtTime(
    0.0001,
    now
  );

  drumGain.gain.exponentialRampToValueAtTime(
    0.22 * intensity,
    now + 0.025
  );

  drumGain.gain.exponentialRampToValueAtTime(
    0.0001,
    now + 0.65
  );

  drum.connect(drumGain);
  drumGain.connect(limboMaster);

  drum.start(now);
  drum.stop(now + 0.7);

  // Low rumbling layer
  const rumble = limboContext.createOscillator();
  const rumbleGain = limboContext.createGain();

  rumble.type = 'triangle';
  rumble.frequency.value = 32;

  rumbleGain.gain.setValueAtTime(
    0.0001,
    now
  );

  rumbleGain.gain.linearRampToValueAtTime(
    0.08 * intensity,
    now + 0.05
  );

  rumbleGain.gain.exponentialRampToValueAtTime(
    0.0001,
    now + 0.9
  );

  rumble.connect(rumbleGain);
  rumbleGain.connect(limboMaster);

  rumble.start(now);
  rumble.stop(now + 1);
}

export function startLimboMusic() {
  if (limboContext) return;

  const AudioContextClass =
    window.AudioContext || window.webkitAudioContext;

  limboContext = new AudioContextClass();

  limboContext.resume();

  limboMaster = limboContext.createGain();
  limboMaster.gain.value = 0.0001;
  limboMaster.connect(limboContext.destination);

  limboMaster.gain.setTargetAtTime(
    0.18,
    limboContext.currentTime,
    3
  );

  const notes = [55, 65.41, 82.41, 110];

  notes.forEach((frequency, index) => {
    const oscillator = limboContext.createOscillator();
    const gain = limboContext.createGain();

    oscillator.type = index === 0 ? 'sawtooth' : 'triangle';
    oscillator.frequency.value = frequency;
    gain.gain.value = 0.035;

    oscillator.connect(gain);
    gain.connect(limboMaster);

    oscillator.start();

    
      limboOscillators.push(choir);

      // HAUNTED CATHEDRAL BELLS
      function ringCathedralBell() {
        if (!limboContext || !limboMaster) return;

        const bell = limboContext.createOscillator();
        const bellGain = limboContext.createGain();

        const notes = [392, 523.25, 659.25, 783.99];

        bell.type = 'sine';
        bell.frequency.value =
          notes[Math.floor(Math.random() * notes.length)];

        bellGain.gain.setValueAtTime(
          0.0001,
          limboContext.currentTime
        );

        bellGain.gain.exponentialRampToValueAtTime(
          0.12,
          limboContext.currentTime + 0.04
        );

        bellGain.gain.exponentialRampToValueAtTime(
          0.0001,
          limboContext.currentTime + 4
        );

        bell.connect(bellGain);
        bellGain.connect(limboMaster);

        bell.start();
        bell.stop(limboContext.currentTime + 4.1);
      }

      const bellTimer = setInterval(() => {
        if (!limboContext) {
          clearInterval(bellTimer);
          return;
        }

        ringCathedralBell();
      }, 7000);
    }
    // =====================================
    // SOVEREIGN OF DESIRE — BOSS MUSIC
    // =====================================

    let bossMusicPhase = 0;
    // SOVEREIGN BOSS SOUNDTRACK LAYERS
    let bossStrings = [];
    let bossChoir = [];
    let bossStringGain = null;
    let bossChoirGain = null;

    export function setBossMusicPhase(phase) {
      if (!limboContext || !limboMaster) return;
      if (bossMusicPhase === phase) return;

      bossMusicPhase = phase;
      // Start the orchestral layers
      createBossMusicLayers();

      if (bossStringGain && bossChoirGain) {
        const now = limboContext.currentTime;

        const stringLevel =
          phase === 1 ? 0.035 :
          phase === 2 ? 0.055 : 0.085;

        const choirLevel =
          phase === 1 ? 0.018 :
          phase === 2 ? 0.045 : 0.075;

        bossStringGain.gain.setTargetAtTime(
          stringLevel, now, 1.5
        );

        bossChoirGain.gain.setTargetAtTime(
          choirLevel, now, 1.5
        );
      }

      if (phase === 1) {
        playInfernalDrum(0.4);
      }
      // =====================================
      // BOSS ORCHESTRAL SOUND LAYERS
      // =====================================

      function createBossMusicLayers() {
        if (!limboContext || !limboMaster) return;

        // Avoid creating duplicate layers
        if (bossStrings.length > 0 || bossChoir.length > 0) return;

        bossStringGain = limboContext.createGain();
        bossStringGain.gain.value = 0.0001;
        bossStringGain.connect(limboMaster);

        bossChoirGain = limboContext.createGain();
        bossChoirGain.gain.value = 0.0001;
        bossChoirGain.connect(limboMaster);

        // Dark orchestral string tones
        [55, 82.41, 110, 164.81].forEach((frequency, index) => {
          const oscillator = limboContext.createOscillator();
          const gain = limboContext.createGain();

          oscillator.type = index === 0 ? 'sawtooth' : 'triangle';
          oscillator.frequency.value = frequency;
          gain.gain.value = 0.018;

          oscillator.connect(gain);
          gain.connect(bossStringGain);
          oscillator.start();

          bossStrings.push(oscillator);
        });
        

        // Haunting choir-like harmonics
        [130.81, 164.81, 196, 261.63].forEach((frequency) => {
          const oscillator = limboContext.createOscillator();
          const gain = limboContext.createGain();

          oscillator.type = 'sine';
          oscillator.frequency.value = frequency;
          gain.gain.value = 0.012;

          oscillator.connect(gain);
          gain.connect(bossChoirGain);
          oscillator.start();

          bossChoir.push(oscillator);
        });
      }

      if (phase === 2) {
        playInfernalDrum(0.8);
        setTimeout(() => playInfernalDrum(0.8), 450);
      }

      if (phase === 3) {
        playInfernalDrum(1.3);
        setTimeout(() => playInfernalDrum(1.3), 300);
        setTimeout(() => playInfernalDrum(1.3), 600);
      
    
   