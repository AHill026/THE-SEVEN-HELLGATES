        └── azrael-model.js

import * as THREE from 'three';

// =============================================
// THE SEVEN HELLGATES
// AZRAEL — CHARACTER MODEL
// =============================================

export function createAzrael(scene) {
  const azrael = new THREE.Group();
  azrael.name = 'AZRAEL';

  const materials = {
    armor: new THREE.MeshStandardMaterial({
      color: 0x17191d,
      metalness: 0.85,
      roughness: 0.38
    }),
    steel: new THREE.MeshStandardMaterial({
      color: 0x343b43,
      metalness: 0.9,
      roughness: 0.3
    }),
    leather: new THREE.MeshStandardMaterial({
      color: 0x30231f,
      roughness: 0.85
    }),
    skin: new THREE.MeshStandardMaterial({
      color: 0xb7aaa0,
      roughness: 0.9
    }),
    burn: new THREE.MeshStandardMaterial({
      color: 0x49302d,
      roughness: 1
    }),
    cloth: new THREE.MeshStandardMaterial({
      color: 0x111216,
      roughness: 1,
      side: THREE.DoubleSide
    }),
    eyes: new THREE.MeshStandardMaterial({
      color: 0x9edcff,
      emissive: 0x55bfff,
      emissiveIntensity: 3
    }),
    rune: new THREE.MeshStandardMaterial({
      color: 0x6cbdeb,
      emissive: 0x238cff,
      emissiveIntensity: 2
    })
  };

  function addMesh(
    geometry,
    material,
    position,
    parent = azrael,
    rotation = [0, 0, 0]
  ) {
    const mesh = new THREE.Mesh(geometry, material);
    mesh.position.set(...position);
    mesh.rotation.set(...rotation);
    mesh.castShadow = true;
    mesh.receiveShadow = true;
    parent.add(mesh);
    return mesh;
  }

  function armorBox(size, position, material = materials.armor, rotation = [0,0,0]) {
    return addMesh(
      new THREE.BoxGeometry(...size),
      material,
      position,
      azrael,
      rotation
    );
  }

  function sphere(radius, position, material, scale = [1,1,1]) {
    const mesh = addMesh(
      new THREE.SphereGeometry(radius, 24, 20),
      material,
      position
    );
    mesh.scale.set(...scale);
    return mesh;
  }

  // BODY — tall athletic proportions

  const torso = addMesh(
    new THREE.CapsuleGeometry(0.48, 0.85, 8, 16),
    materials.leather,
    [0, 1.65, 0]
  );

  // NECK AND HEAD

  addMesh(
    new THREE.CylinderGeometry(0.17, 0.21, 0.3, 16),
    materials.skin,
    [0, 2.38, 0]
  );

  sphere(0.34, [0, 2.77, 0], materials.skin, [0.85, 1.15, 0.85]);

  // DARK HAIR

  sphere(0.34, [0, 3.02, -0.035], materials.armor, [1.03, 0.55, 1]);

  for (let i = 0; i < 5; i++) {
    addMesh(
      new THREE.CapsuleGeometry(0.035, 0.25, 4, 8),
      materials.armor,
      [-0.22 + i * 0.11, 3.08, -0.19]
    );
  }

  // PALE BLUE EYES

  for (const x of [-0.125, 0.125]) {
    const eye = sphere(
      0.047,
      [x, 2.81, 0.285],
      materials.eyes,
      [1.15, 0.55, 0.65]
    );
    eye.name = 'Azrael_Glowing_Eye';
  }

  // BURN SCARS — face details

  for (let i = 0; i < 4; i++) {
    const scar = addMesh(
      new THREE.BoxGeometry(0.035, 0.13 + i * 0.025, 0.018),
      materials.burn,
      [-0.24 + i * 0.035, 2.77 - i * 0.035, 0.275],
      azrael,
      [0, 0, -0.35]
    );
    scar.name = 'Facial_Burn_Scar';
  }

  // PARTIAL FACE ARMOR

  armorBox(
    [0.16, 0.39, 0.075],
    [-0.25, 2.76, 0.29],
    materials.steel,
    [0, 0, -0.12]
  );

  // CHEST ARMOR

  armorBox([0.88, 0.48, 0.16], [0, 1.94, 0.36], materials.steel);
  armorBox([0.7, 0.3, 0.19], [0, 1.65, 0.36]);
  armorBox([0.26, 0.52, 0.12], [0, 1.95, 0.47], materials.armor);

  // CHEST CENTER EMBLEM

  sphere(0.11, [0, 1.91, 0.52], materials.rune, [1, 1.2, 0.35]);

  // SHOULDERS — asymmetrical gothic armor

  addMesh(
    new THREE.SphereGeometry(0.36, 24, 20),
    materials.steel,
    [-0.64, 2.05, 0]
  );

  addMesh(
    new THREE.SphereGeometry(0.26, 24, 20),
    materials.armor,
    [0.62, 2.05, 0]
  );

  armorBox([0.18, 0.43, 0.3], [-0.7, 1.79, 0], materials.armor, [0,0,-0.15]);

  // ARMS

  for (const side of [-1, 1]) {
    const x = side * 0.65;

    addMesh(
      new THREE.CapsuleGeometry(0.13, 0.48, 6, 12),
      materials.leather,
      [x, 1.65, 0]
    );

    addMesh(
      new THREE.CapsuleGeometry(0.14, 0.38, 6, 12),
      materials.steel,
      [x, 1.18, 0]
    );

    sphere(0.15, [x, 0.91, 0], materials.armor, [1,1,0.8]);
  }

  // WAIST ARMOR

  armorBox([0.65, 0.24, 0.35], [0, 1.12, 0], materials.steel);

  // TORN MANTLE

  for (const side of [-1, 1]) {
    const cape = addMesh(
      new THREE.PlaneGeometry(0.52, 1.55, 4, 8),
      materials.cloth,
      [side * 0.3, 0.88, -0.23],
      azrael,
      [0.12, 0, side * -0.08]
    );

    cape.name = 'Torn_Black_Mantle';
  }

  // LEGS

  for (const side of [-1, 1]) {
    const x = side * 0.23;

    addMesh(
      new THREE.CapsuleGeometry(0.19, 0.62, 6, 12),
      materials.leather,
      [x, 0.59, 0]
    );

    armorBox(
      [0.32, 0.28, 0.16],
      [x, 0.38, 0.12],
      materials.steel
    );

    addMesh(
      new THREE.BoxGeometry(0.3, 0.43, 0.4),
      materials.armor,
      [x, 0.12, 0.04]
    );
  }

  // EXECUTIONER GREATSWORD

  const sword = new THREE.Group();
  sword.name = 'Azrael_Executioner_Greatsword';
  sword.position.set(0.95, 1.2, 0.15);
  sword.rotation.z = -0.45;
  azrael.add(sword);

  const blade = addMesh(
    new THREE.BoxGeometry(0.23, 1.85, 0.065),
    materials.steel,
    [0, 1.25, 0],
    sword
  );

  const guard = addMesh(
    new THREE.BoxGeometry(0.75, 0.11, 0.12),
    materials.armor,
    [0, 0.27, 0],
    sword
  );

  addMesh(
    new THREE.CylinderGeometry(0.055, 0.055, 0.85, 12),
    materials.leather,
    [0, -0.2, 0],
    sword
  );

  // BLADE RUNES

  for (let i = 0; i < 5; i++) {
    addMesh(
      new THREE.BoxGeometry(0.045, 0.11, 0.075),
      materials.rune,
      [0, 0.55 + i * 0.24, 0.05],
      sword,
      [0, 0, Math.PI / 4]
    );
  }

  // MODEL POSITION

  azrael.position.set(0, 0, 0);
  azrael.scale.setScalar(1);

  scene.add(azrael);

  return azrael;
}
