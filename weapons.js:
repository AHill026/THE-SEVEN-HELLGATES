


import * as THREE from 'three';

// =====================================
// INFERNAL RIPPER MK-I COMBAT SYSTEM
// =====================================

export function createInfernalRipperCombat({
  camera,
  state,
  ripperRig,
  enemies,
  spawnBurst,
  spawnBlood,
  spawnSparks,
  showMessage
}) {
  let damageCooldown = 0;

  function start() {
    if (state.activeWeapon !== 'infernalripper') return;

    ripperRig.userData.active = true;

    if (ripperRig.userData.glow) {
      ripperRig.userData.glow.intensity = 4;
    }

    showMessage('INFERNAL RIPPER — ENGAGED!');
  }

  function stop() {
    ripperRig.userData.active = false;

    if (ripperRig.userData.glow) {
      ripperRig.userData.glow.intensity = 2;
    }
  }

  function update(dt) {
    if (!ripperRig.userData.active) return;

    // Rotate the Infernal Ripper teeth
    if (ripperRig.userData.toothGroup) {
      ripperRig.userData.toothGroup.rotation.z += dt * 22;
    }

    // Damage cooldown
    damageCooldown -= dt;

    if (damageCooldown > 0) return;

    damageCooldown = 0.25;

    const forward = new THREE.Vector3(0, 0, -1)
      .applyQuaternion(camera.quaternion);

    enemies.forEach(enemy => {
      if (!enemy.userData.alive) return;

      const direction = enemy.position.clone()
        .sub(camera.position);

      const distance = direction.length();

      if (distance > 2.8) return;

      direction.normalize();

      if (forward.dot(direction) < 0.65) return;

      // Apply damage
      enemy.userData.health -= 12;

      if (spawnBlood) {
        spawnBlood(enemy.position.clone(), 8);
      }

      if (spawnSparks) {
        spawnSparks(enemy.position.clone(), 10);
      }

      // Enemy defeated
      if (enemy.userData.health <= 0) {
        enemy.userData.health = 0;
        enemy.userData.alive = false;
        enemy.userData.dying = true;
        enemy.userData.deathTimer = 0;

        spawnBurst(
          enemy.position.clone(),
          0xff2200
        );

        state.kills++;

        showMessage('INFERNAL RIPPER — DEVOURING CUT');
      }
    });
  }

  return {
    start,
    stop,
    update
  };
}
